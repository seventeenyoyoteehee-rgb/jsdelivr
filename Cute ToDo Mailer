// 支援每日小語、代辦清單操作、每日背景色變化及寄送信箱功能

import React, { useState, useEffect } from 'react';

export default function CuteTodoApp() {
  const [task, setTask] = useState('');
  const [todos, setTodos] = useState([]);
  const [email, setEmail] = useState('');
  const [sending, setSending] = useState(false);
  const [dailyQuote, setDailyQuote] = useState('');
  const [bgColor, setBgColor] = useState('bg-emerald-50');

  const quotes = [
    '今天也是努力的一天，給自己一個微笑 🌱',
    '你比自己想像的更堅強 💚',
    '一步步慢慢來，每一步都是進步 🍃',
    '記得對自己溫柔，今天也很棒 🌿',
    '小小的努力，也值得被看見 ✨',
  ];

  const bgColors = [
    'bg-emerald-50',
    'bg-green-50',
    'bg-lime-50',
    'bg-teal-50',
    'bg-rose-50',
    'bg-blue-50',
    'bg-yellow-50',
  ];

  useEffect(() => {
    // 每日小語隨機選一個
    const randomQuoteIndex = Math.floor(Math.random() * quotes.length);
    setDailyQuote(quotes[randomQuoteIndex]);

    // 背景顏色每日變色（依日期生成索引）
    const date = new Date();
    const colorIndex = date.getDate() % bgColors.length;
    setBgColor(bgColors[colorIndex]);
  }, []);

  // 每小時背景自動循環變色
  useEffect(() => {
    const interval = setInterval(() => {
      const randomColorIndex = Math.floor(Math.random() * bgColors.length);
      setBgColor(bgColors[randomColorIndex]);
    }, 3600000); // 每小時更新一次背景色
    return () => clearInterval(interval);
  }, []);

  const addTodo = () => {
    if (!task.trim()) return;
    setTodos([...todos, { text: task, done: false }]);
    setTask('');
  };

  const toggleTodo = (index) => {
    const newTodos = [...todos];
    newTodos[index].done = !newTodos[index].done;
    setTodos(newTodos);
  };

  const sendEmail = async () => {
    if (!email.trim()) return alert('請輸入信箱 ✉️');
    setSending(true);

    try {
      const response = await fetch('/api/sendEmail', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, todos }),
      });
      const data = await response.json();
      alert(data.message || '信件已寄出 🍃');
    } catch (err) {
      console.error(err);
      alert('寄送失敗，請檢查伺服器設定 ⚠️');
    }

    setSending(false);
  };

  return (
    <div className={`min-h-screen ${bgColor} flex flex-col items-center py-10 px-4 transition-colors duration-1000`}> 
      <h1 className="text-4xl font-bold text-emerald-700 mb-2">🌿 今日待辦清單</h1>
      <p className="text-emerald-600 mb-6 italic">"{dailyQuote}"</p>

      <div className="w-full max-w-md bg-white/90 backdrop-blur-md rounded-2xl p-6 shadow-xl border border-emerald-200">
        <div className="flex gap-2 mb-4">
          <input
            placeholder="輸入代辦事項..."
            value={task}
            onChange={(e) => setTask(e.target.value)}
            className="flex-1 border border-emerald-300 rounded-xl px-3 py-2"
          />
          <button onClick={addTodo} className="bg-emerald-500 text-white px-4 rounded-xl">新增</button>
        </div>
        <ul className="space-y-2">
          {todos.map((todo, index) => (
            <li key={index} className="flex justify-between items-center p-3 border rounded-xl cursor-pointer bg-emerald-50 hover:bg-emerald-100" onClick={() => toggleTodo(index)}>
              <span className={todo.done ? 'line-through text-gray-400' : 'text-emerald-800'}>{todo.text}</span>
              {todo.done && <span>✅</span>}
            </li>
          ))}
        </ul>
        <div className="mt-4 flex gap-2">
          <input
            placeholder="輸入收信信箱..."
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            className="flex-1 border border-emerald-300 rounded-xl px-3 py-2"
          />
          <button onClick={sendEmail} disabled={sending} className="bg-emerald-500 text-white px-4 rounded-xl">
            {sending ? '寄送中...' : '立即寄送'}
          </button>
        </div>
      </div>
    </div>
  );
}
